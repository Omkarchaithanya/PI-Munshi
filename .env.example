# Copy to .env and fill. Server-only. Never prefix with VITE_ (that ships to the browser).
# Restart `npm run dev` after edits.

# Sarvam voice (STT / TTS / translate). Empty = browser TTS + demo badge.
SARVAM_API_KEY=

# Paytm gateway. Empty = DEMO sandbox, not live money movement.
PAYTM_MID=
PAYTM_MERCHANT_KEY=

# Postgres. Empty = local PGlite. This is the payment ledger (Render).
DATABASE_URL=

# Tiger Cloud / Timescale. Time-series only. Do not put this in DATABASE_URL.
TIMESCALE_DATABASE_URL=
